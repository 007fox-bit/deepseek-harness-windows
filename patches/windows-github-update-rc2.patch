+ * @param platform Target platform.
+ * @param arch Target architecture.
+ * @param unsigned Whether the package omits a publisher signature.
+ * @returns Validated generic-provider settings, or undefined when the file omits the opt-in.
+ */
+export function resolveDesktopCommunityUpdateConfig(
+  environment: NodeJS.ProcessEnv,
+  platform: NodeJS.Platform,
+  arch: string,
+  unsigned: boolean,
+): DesktopCommunityUpdateConfig | undefined
