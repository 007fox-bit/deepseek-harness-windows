+export const DESKTOP_COMMUNITY_UPDATE_URL: 'DSH_DESKTOP_COMMUNITY_UPDATE_URL'
+
+/** Validated downstream updater settings for one unsigned Windows package. */
+export interface DesktopCommunityUpdateConfig {
+  readonly channel: 'nightly'
+  readonly publicUrl: string
+}
