+import { describe, expect, it } from 'vitest'
+import { resolveDesktopCommunityUpdateConfig } from '../scripts/desktop-community-update-environment.mjs'
+
+const URL = 'https://github.com/example/community/releases/download/windows-update'
+
+describe('community Windows update environment', () => {
+  it('keeps ordinary packages on the official release path', () => {
+    expect(resolveDesktopCommunityUpdateConfig({}, 'win32', 'x64', true)).toBeUndefined()
+  })
+
+  it('normalizes one explicit unsigned Windows x64 feed', () => {
+    expect(resolveDesktopCommunityUpdateConfig({ DSH_DESKTOP_COMMUNITY_UPDATE_URL: URL }, 'win32', 'x64', true))
+      .toEqual({ channel: 'nightly', publicUrl: `${URL}/` })
+  })
+
+  it.each([
+    ['signed package', 'win32', 'x64', false],
+    ['macOS package', 'darwin', 'x64', true],
+    ['Windows arm64 package', 'win32', 'arm64', true],
+  ] as const)('rejects the community feed for a %s', (_name, platform, arch, unsigned) => {
+    expect(() => resolveDesktopCommunityUpdateConfig({ DSH_DESKTOP_COMMUNITY_UPDATE_URL: URL }, platform, arch, unsigned))
+      .toThrow('requires unsigned Windows x64 packaging')
+  })
+
+  it.each([
+    'http://updates.example.com/feed',
+    'https://user:secret@updates.example.com/feed',
+    'https://updates.example.com/feed?channel=nightly',
+    'https://updates.example.com/feed#nightly',
+    'not-a-url',
+  ])('rejects unsafe feed URL %s', (url) => {
+    expect(() => resolveDesktopCommunityUpdateConfig({ DSH_DESKTOP_COMMUNITY_UPDATE_URL: url }, 'win32', 'x64', true))
+      .toThrow(/DSH_DESKTOP_COMMUNITY_UPDATE_URL/u)
+  })
+})
