+/** Validate the downstream community update source without changing official release routing. */
+
+/** Environment variable that opts an unsigned Windows x64 package into the community feed. */
+export const DESKTOP_COMMUNITY_UPDATE_URL = 'DSH_DESKTOP_COMMUNITY_UPDATE_URL'
+
+/**
+ * Resolve the community updater only for an explicitly unsigned Windows x64 package.
+ * @param {NodeJS.ProcessEnv} environment File-owned packaging settings.
+ * @param {NodeJS.Platform} platform Target platform.
+ * @param {string} arch Target architecture.
+ * @param {boolean} unsigned Whether the package omits a publisher signature.
+ * @returns {{ channel: 'nightly', publicUrl: string } | undefined} Validated generic-provider settings.
+ */
+export function resolveDesktopCommunityUpdateConfig(environment, platform, arch, unsigned) {
+  const value = environment[DESKTOP_COMMUNITY_UPDATE_URL]?.trim()
+  if (!value) return undefined
+  if (!unsigned || platform !== 'win32' || arch !== 'x64') {
+    throw new Error(`desktop community update: ${DESKTOP_COMMUNITY_UPDATE_URL} requires unsigned Windows x64 packaging`)
+  }
+  let url
+  try { url = new URL(value) }
+  catch { throw new Error(`desktop community update: ${DESKTOP_COMMUNITY_UPDATE_URL} must be an absolute HTTPS URL`) }
+  if (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash) {
+    throw new Error(`desktop community update: ${DESKTOP_COMMUNITY_UPDATE_URL} must be HTTPS without credentials, query, or fragment`)
+  }
+  url.pathname = `${url.pathname.replace(/\/+$/u, '')}/`
+  return { channel: 'nightly', publicUrl: url.toString() }
+}
